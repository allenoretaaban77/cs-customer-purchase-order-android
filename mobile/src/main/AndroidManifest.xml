            android:enabled="true"
            android:targetActivity=".activity.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:label="@string/app_name"
            android:icon="@mipmap/ic_launcher"
            android:name=".FNC"
            android:enabled="false"
            android:targetActivity=".activity.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:label="@string/app_name_massive"
            android:icon="@mipmap/ic_launcher_massive"
            android:name=".MASSIVES"
            android:enabled="false"
            android:targetActivity=".activity.SplashActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias-->

        <service
            android:enabled="true"
            android:exported="true"
            android:process=":FNCCustomerOrderService"
            android:stopWithTask="false"
            android:name=".services.OrdersService">
        </service>

        <receiver
            android:enabled="true"
            android:exported="true"
            android:name=".services.ServiceStarter">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>