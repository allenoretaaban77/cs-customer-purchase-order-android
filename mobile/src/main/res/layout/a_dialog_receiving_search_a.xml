<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        style="@style/a_frameBox"
        android:orientation="vertical">

        <LinearLayout
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" >
                <LinearLayout
                    style="@style/a_frameBoxInner"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="5dp"
                        android:layout_weight="1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RelativeLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_alignParentRight="true"
                            android:background="@color/transparent"
                            style="@style/btnTransparentStyleSmallWrap">
                            <com.balysv.materialripple.MaterialRippleLayout
                                android:id="@+id/ll_startdate"
                                android:padding="2dp"
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <Button
                                    android:drawableTint="@color/green_1"
                                    android:background="@drawable/calendar_check_outline"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </com.balysv.materialripple.MaterialRippleLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:layout_weight="1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">
                            <FrameLayout
                                android:paddingLeft="0dp"
                                android:background="@color/transparent"
                                android:layout_width="match_parent"
                                android:layout_height="28dp">
                                <EditText
                                    android:fontFamily="@font/light"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:id="@+id/et_startdate"
                                    android:hint="Start Date"
                                    android:background="@color/transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="15sp"
                                    android:maxLines="1"
                                    android:lines="1"
                                    android:inputType="text"
                                    android:imeOptions="actionSearch"
                                    android:textColorHint="@color/green_3"
                                    android:textColor="@color/green_5"
                                    android:paddingLeft="2dp"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_marginLeft="5dp"
                        android:layout_marginRight="10dp"
                        android:layout_weight="1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <RelativeLayout
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_alignParentRight="true"
                            android:background="@color/transparent"
                            style="@style/btnTransparentStyleSmallWrap">
                            <com.balysv.materialripple.MaterialRippleLayout
                                android:id="@+id/ll_enddate"
                                android:padding="2dp"
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">
                                <Button
                                    android:drawableTint="@color/green_1"
                                    android:background="@drawable/calendar_check_outline"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"/>
                            </com.balysv.materialripple.MaterialRippleLayout>
                        </RelativeLayout>
                        <LinearLayout
                            android:layout_weight="1"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal">
                            <FrameLayout
                                android:paddingLeft="0dp"
                                android:background="@color/transparent"
                                android:layout_width="match_parent"
                                android:layout_height="28dp">
                                <EditText
                                    android:fontFamily="@font/light"
                                    android:focusable="false"
                                    android:focusableInTouchMode="false"
                                    android:id="@+id/et_enddate"
                                    android:hint="End Date"
                                    android:background="@color/transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:textSize="15sp"
                                    android:maxLines="1"
                                    android:lines="1"
                                    android:inputType="text"
                                    android:imeOptions="actionSearch"
                                    android:textColorHint="@color/blue_5a"
                                    android:textColor="@color/blue_5"
                                    android:paddingLeft="2dp"/>
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
                <TextView style="@style/a_frameBoxLabel"
                    android:text="Delivery/Received Date"/>
            </RelativeLayout>


            <RelativeLayout
                android:layout_weight="1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" >
                <LinearLayout
                    style="@style/a_frameBoxInner"
                    android:orientation="vertical">
                    <RelativeLayout
                        android:layout_marginTop="-1dp"
                        android:paddingLeft="0dp"
                        android:paddingRight="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:orientation="horizontal">
                        <Spinner
                            android:fontFamily="@font/light"
                            android:id="@+id/spnr_posstatus"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_centerVertical="true"
                            android:layout_gravity="center"
                            android:background="@android:color/transparent"
                            android:gravity="center"
                            android:spinnerMode="dropdown" />
                        <ImageView
                            android:tint="@color/green_4"
                            android:backgroundTint="@color/green_4"
                            android:layout_marginRight="7dp"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentRight="true"
                            android:layout_centerVertical="true"
                            android:layout_gravity="center"
                            android:src="@mipmap/baseline_arrow_drop_down_white" />
                    </RelativeLayout>
                </LinearLayout>
                <TextView style="@style/a_frameBoxLabel"
                    android:text="POS Status"/>
            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_marginRight="4dp"
                android:layout_weight="0.5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" >
                <LinearLayout
                    style="@style/a_frameBoxInner"
                    android:orientation="vertical">
                    <FrameLayout
                        android:padding="5dp"
                        android:background="@color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="28dp">
                        <EditText
                            android:id="@+id/et_supplier"
                            android:fontFamily="@font/light"
                            android:background="@color/transparent"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:textSize="16sp"
                            android:maxLines="1"
                            android:lines="1"
                            android:inputType="text"
                            android:imeOptions="actionDone"
                            android:textColorHint="@color/green_3"
                            android:textColor="@color/green_5"
                            android:paddingLeft="2dp"/>
                    </FrameLayout>
                </LinearLayout>
                <TextView style="@style/a_frameBoxLabel"
                    android:text="Supplier"/>
            </RelativeLayout>

            <LinearLayout
                android:paddingRight="5dp"
                android:paddingTop="7dp"
                android:paddingBottom="9dp"
                style="@style/a_frameBoxInner"
                android:orientation="horizontal">
                <TextView
                    android:layout_marginLeft="5dp"
                    android:layout_marginRight="5dp"
                    android:fontFamily="@font/light"
                    android:gravity="center"
                    android:textSize="17sp"
                    android:textColor="@color/green_5"
                    android:text="Find PO"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
                <com.balysv.materialripple.MaterialRippleLayout
                    android:backgroundTint="@color/transparent"
                    android:background="@color/transparent"
                    android:id="@+id/btn_refresh"
                    android:layout_width="23dp"
                    android:layout_height="23dp">
                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/baseline_search_24"
                        android:backgroundTint="@color/gold_3" />
                </com.balysv.materialripple.MaterialRippleLayout>
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>
    <TextView style="@style/a_frameBoxLabel" android:text="Filter PO List"/>
</RelativeLayout>