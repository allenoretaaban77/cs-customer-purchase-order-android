<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:paddingLeft="5dp"
    android:paddingBottom="0dp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!--<LinearLayout-->
        <!--android:id="@+id/menu_arrowbottomleft"-->
        <!--android:layout_width="7dp"-->
        <!--android:layout_height="match_parent"-->
        <!--android:layout_marginBottom="10dp"-->
        <!--android:orientation="horizontal"-->
        <!--android:backgroundTint="@color/gold_2"-->
        <!--android:background="@drawable/arrowleft"-->
        <!--android:layout_gravity="left"-->
        <!--/>-->
    <LinearLayout
        android:id="@+id/remarks_msg"
        android:padding="3dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/popupbg_remarks"
        android:orientation="vertical">
        <TextView
            android:layout_marginRight="7dp"
            android:layout_marginLeft="7dp"
            android:visibility="visible"
            android:id="@+id/tv_infomsg"
            android:maxWidth="200dp"
            android:textSize="15dp"
            android:textColor="@color/gray_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remarks:"/>
        <LinearLayout
            android:layout_marginBottom="2dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <EditText
                android:hint="Please inout reason here."
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:id="@+id/et_remarkmsg"
                android:inputType="textMultiLine"
                android:textSize="14dp"
                android:lineHeight="14dp"
                android:paddingTop="2dp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:gravity="top"
                android:lines="4"
                android:background="@drawable/background_round_border_inner_transparent"
                android:layout_width="200dp"
                android:layout_height="match_parent"
                android:text=""/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>