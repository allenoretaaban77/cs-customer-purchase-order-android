<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.fnc.order.android.activity.LoginActivity"
    android:background="@drawable/background_gradient"
    android:gravity="center"
    tools:ignore="MissingPrefix"
    android:orientation="vertical">

    <ImageView
        android:contentDescription="@string/app_name"
        android:layout_gravity="center"
        android:alpha=".1"
        android:backgroundTintMode="src_over"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:src="@drawable/po1" />

    <ScrollView
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/transparent"
        android:visibility="visible" >

        <LinearLayout
            android:id="@+id/email_login_form"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="58dp">
                    <ImageView
                        android:layout_marginEnd="10dp"
                        android:background="@mipmap/ic_launcher"
                        android:layout_width="58dp"
                        android:contentDescription="@string/app_name"
                        android:layout_height="match_parent"/>
                    <LinearLayout
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">
                        <TextView
                            android:fontFamily="@font/medium"
                            android:textSize="@dimen/login_title_text_size"
                            android:textColor="@color/black"
                            android:layout_gravity="center"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/app_name"/>
                    </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:fontFamily="@font/regular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:autofillHints="Please enter user name"
                    android:textSize="@dimen/header_text_size"
                    android:fontFamily="@font/medium"
                    android:id="@+id/username"
                    android:textColorHint="@color/gray_4"
                    android:textColor="@color/gray_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/prompt_username"
                    android:imeActionLabel="@string/action_next"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"/>
            </com.google.android.material.textfield.TextInputLayout>

            <FrameLayout
                android:layout_marginTop="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.google.android.material.textfield.TextInputLayout
                    android:fontFamily="@font/regular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <EditText
                        android:autofillHints="Please enter pass word"
                        android:textSize="@dimen/header_text_size"
                        android:fontFamily="@font/medium"
                        android:id="@+id/password"
                        android:textColorHint="@color/gray_4"
                        android:textColor="@color/gray_6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/prompt_password"
                        android:imeActionLabel="@string/action_next"
                        android:imeOptions="actionDone"
                        android:inputType="textWebPassword"
                        android:maxLines="1"
                        android:singleLine="true"/>
                </com.google.android.material.textfield.TextInputLayout>
                <RelativeLayout
                    android:id="@+id/relPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:visibility="gone">
                    <Button
                        android:id="@+id/hide_password"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="15dp"
                        android:background="@mipmap/ic_visibility_black_24dp"
                        />
                    <Button
                        android:id="@+id/show_password"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_margin="15dp"
                        android:background="@mipmap/ic_visibility_off_black_24dp"
                        />
                </RelativeLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_marginTop="20dp"
                style="@style/btnTransparentStyle">
                <com.balysv.materialripple.MaterialRippleLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <Button
                        android:textSize="@dimen/header_text_size"
                        android:fontFamily="@font/medium"
                        android:background="@android:color/transparent"
                        android:id="@+id/login_button"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="@string/button_login"
                        android:textColor="@color/white"
                        android:textAllCaps="false"/>
                </com.balysv.materialripple.MaterialRippleLayout>
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_gravity="bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_margin="20dp"
            android:fontFamily="@font/regular"
            android:textColor="@color/red_1"
            android:textSize="19sp"
            android:textAlignment="textEnd"
            android:id="@+id/tv_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>