<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/tv_item_box"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.balysv.materialripple.MaterialRippleLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:paddingTop="12dp"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:orientation="vertical"
                android:id="@+id/lst_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_marginLeft="5dp"
                    android:textSize="18dp"
                    android:id="@+id/tv_itemname"
                    android:text="Test"
                    android:textColor="@color/red_2"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"/>
                <TextView
                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="-3dp"
                    android:textStyle="bold"
                    android:textSize="15dp"
                    android:id="@+id/tv_itemunit"
                    android:text="Test"
                    android:textColor="@color/orange_1"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"/>
                <View
                    android:layout_marginTop="15dp"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="@color/red_2"/>
                <!--<TextView-->
                    <!--android:layout_marginTop="2dp"-->
                    <!--android:textSize="16dp"-->
                    <!--android:id="@+id/tv_itemdept"-->
                    <!--android:text="Test"-->
                    <!--android:textColor="@color/brown_3"-->
                    <!--android:layout_height="match_parent"-->
                    <!--android:layout_width="match_parent"/>-->
            </LinearLayout>
        </com.balysv.materialripple.MaterialRippleLayout>
    </LinearLayout>

    <LinearLayout
        android:visibility="gone"
        android:id="@+id/tv_empty_item_box"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:background="@android:color/transparent"
            android:id="@+id/tv_empty"
            android:gravity="center"
            android:textAlignment="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

</LinearLayout>