<com.daimajia.swipe.SwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/bottom_wrapper"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <com.balysv.materialripple.MaterialRippleLayout
            android:id="@+id/btn_remarks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#66ddff00">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/baseline_chat_24" />
        </com.balysv.materialripple.MaterialRippleLayout>

        <com.balysv.materialripple.MaterialRippleLayout
            android:id="@+id/btn_delete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="#66FF3300">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:src="@drawable/baseline_delete_forever_24" />
        </com.balysv.materialripple.MaterialRippleLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/item_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#ffffff">

        <TableRow xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true">
            <TextView
                android:background="@color/transparent"
                android:focusable="true"
                android:maxLines="1"
                android:textStyle="bold"
                android:digits="1234567890."
                android:inputType="numberDecimal"
                android:paddingRight="7dp"
                android:textSize="20sp"
                android:imeOptions="actionNext"
                android:maxLength="10"
                android:gravity="right|center_vertical"
                android:id="@+id/cell_qty"
                android:layout_width="100dp"
                android:layout_column="0"
                style="@style/tblCellTextView">
            </TextView>
            <TextView
                android:layout_weight="1"
                android:paddingLeft="7dp"
                android:gravity="center|center_vertical"
                android:id="@+id/cell_unit"
                style="@style/tblCellTextView"
                android:layout_column="1" />
            <LinearLayout
                android:layout_column="2"
                style="@style/tblCellTextView"
                android:layout_width="320dp">
                <TextView
                    android:textColor="@color/brown_4"
                    android:textSize="14dp"
                    android:lineHeight="14dp"
                    android:paddingRight="10dp"
                    android:paddingLeft="10dp"
                    android:gravity="center_vertical"
                    android:id="@+id/cell_description"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:layout_width="80dp"
                android:paddingRight="5dp"
                android:gravity="right|center_vertical"
                android:id="@+id/cell_price"
                style="@style/tblCellTextView"
                android:layout_column="3" />
            <TextView
                android:textSize="14dp"
                android:layout_width="80dp"
                android:paddingRight="5dp"
                android:gravity="right|center_vertical"
                android:id="@+id/cell_total"
                style="@style/tblCellTextView"
                android:layout_column="4" />
        </TableRow>

    </LinearLayout>

