<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/background_round_border_inner_transparent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_height="wrap_content"
            style="@style/layoutStyleMenu"
            android:layout_width="750dp"
            android:orientation="horizontal"
            android:background="@drawable/background_round_border">
            <TextView
                android:textAlignment="center"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:textColor="@color/white"
                android:layout_height="wrap_content"
                android:layout_width="match_parent"
                android:fontFamily="@font/regular"
                android:textSize="20sp"
                android:text="TRANSACTION ITEMS"/>
            <LinearLayout
                android:layout_margin="5dp"
                android:layout_alignParentRight="true"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:padding="3dp"
                style="@style/btnTransparentStyleSmallWrap">
                <com.balysv.materialripple.MaterialRippleLayout
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="3dp">
                    <Button
                        android:backgroundTint="@color/white"
                        android:background="@drawable/baseline_close_24"
                        android:id="@+id/btn_close"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </com.balysv.materialripple.MaterialRippleLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginTop="50dp"
            style="@style/layoutStyleMenu"
            android:layout_width="750dp"
            android:background="@drawable/background_round_border"
            android:padding="5dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TableRow
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:id="@+id/ref_desc_elem"
                            style="@style/tblCellTextViewHeader"
                            android:layout_weight="1"
                            android:layout_column="0"
                            android:text="Description" />
                        <TextView
                            style="@style/tblCellTextViewHeader"
                            android:layout_width="80dp"
                            android:layout_column="1"
                            android:text="Price" />
                        <TextView
                            style="@style/tblCellTextViewHeader"
                            android:layout_width="90dp"
                            android:layout_column="2"
                            android:text="Quantity" />
                        <TextView
                            style="@style/tblCellTextViewHeader"
                            android:layout_width="80dp"
                            android:layout_column="3"
                            android:text="Total" />
                    </TableRow>
                </TableLayout>
            </RelativeLayout>

            <LinearLayout
                android:layout_marginTop="2dp"
                android:id="@+id/alphagridview_box"
                android:background="@drawable/background_green_3_border"
                android:layout_height="match_parent"
                android:layout_width="match_parent"
                android:orientation="vertical">

                <ListView xmlns:android="http://schemas.android.com/apk/res/android"
                    android:id="@+id/list_view"
                    android:divider="#00000000"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>

</ScrollView>
