<?xml version="1.0" encoding="utf-8"?>
<com.infideap.drawerbehavior.AdvanceDrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/a_background_border_inner"
    android:fitsSystemWindows="true"
    tools:openDrawer="start">

    <com.google.android.material.navigation.NavigationView
        app:itemIconTint="@color/gold_3"
        app:itemTextColor="@color/gold_3"
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/a_menu_header"
        android:background="@drawable/a_background_border_inner"
        app:menu="@menu/menu" />

    <!--com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view_notification"
        android:background="@color/colorPrimary"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fitsSystemWindows="false">
        <include layout="@layout/a_notification_content"/>
    </com.google.android.material.navigation.NavigationView-->


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:background="@color/white_1"
        tools:showIn="@layout/a_activity_main">

            <androidx.appcompat.widget.Toolbar
                app:titleTextAppearance="@style/tblCellTextView"
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/a_background_header" />

            <FrameLayout
                android:layout_marginTop="45dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/container"
                android:layout_weight="1">

                <!--include layout="@layout/a_fragment_receiving" /-->

            </FrameLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</com.infideap.drawerbehavior.AdvanceDrawerLayout>
