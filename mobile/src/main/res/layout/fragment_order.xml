<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:tools="http://schemas.android.com/tools"
    app:layout_behavior="@string/appbar_scrolling_view_behavior"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/background_gradient">

    <ImageView
        android:alpha="0.3"
        android:src="@drawable/afpmc"
        android:scaleType="centerCrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true" />

    <LinearLayout
        android:layout_margin="5dp"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:background="@drawable/background_round_border"
        android:orientation="vertical"
        android:padding="7dp">

        <RelativeLayout
            style="@style/mHeader">
            <RelativeLayout
                android:layout_height="match_parent"
                android:layout_width="match_parent">
                <TextView
                    android:id="@+id/headertitle"
                    android:gravity="center"
                    android:layout_height="match_parent"
                    android:layout_width="match_parent"
                    android:textFontWeight="700"
                    android:text="ORDER ITEMS"
                    android:textStyle="bold"
                    android:textSize="19sp"
                    android:textColor="@color/gray_6"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_marginRight="45dp"
                    android:id="@+id/tv_version"
                    android:layout_alignParentRight="true"
                    android:fontFamily="sans-serif-smallc"
                    android:textColor="@color/gray_5"
                    android:layout_gravity="center_horizontal"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:textSize="12dp"
                    android:text="1.0.1"/>
            </RelativeLayout>
            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="left"
                android:layout_weight="1">
                <com.balysv.materialripple.MaterialRippleLayout
                    android:id="@+id/btn_back"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <ImageButton
                        android:layout_width="55dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="left"
                        android:backgroundTint="@color/gold_1"
                        android:background="@android:color/transparent"
                        android:src="@drawable/baseline_arrow_back_ios_24"/>
                </com.balysv.materialripple.MaterialRippleLayout>
            </RelativeLayout>
            <RelativeLayout
                android:layout_alignParentRight="true"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="right"
                android:layout_weight="1">
                <com.balysv.materialripple.MaterialRippleLayout
                    android:id="@+id/btn_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">
                    <Button
                        android:layout_margin="12dp"
                        android:backgroundTint="@color/gray_6"
                        android:background="@drawable/baseline_menu_24"
                        android:layout_width="25dp"
                        android:layout_height="25dp"/>
                </com.balysv.materialripple.MaterialRippleLayout>
            </RelativeLayout>
        </RelativeLayout>

        <android.support.design.widget.CoordinatorLayout
            android:id="@+id/content_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/background_green_3_border"
            android:orientation="vertical"
            android:padding="3dp">

            <LinearLayout
                android:id="@+id/ref_coordinateor_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="175dp"
                android:orientation="vertical"
                android:paddingBottom="55dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/header_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:paddingLeft="1dp"
                            android:paddingRight="1dp">

                            <TableRow
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <TextView
                                    style="@style/tblCellTextViewHeader"
                                    android:layout_width="100dp"
                                    android:layout_column="0"
                                    android:text="Quantity" />

                                <TextView
                                    style="@style/tblCellTextViewHeader"
                                    android:layout_width="150dp"
                                    android:layout_column="1"
                                    android:layout_weight="1"
                                    android:text="Unit" />

                                <TextView
                                    android:id="@+id/ref_desc_elem"
                                    style="@style/tblCellTextViewHeader"
                                    android:layout_width="320dp"
                                    android:layout_column="2"
                                    android:text="Description" />

                                <TextView
                                    style="@style/tblCellTextViewHeader"
                                    android:layout_width="80dp"
                                    android:layout_column="3"
                                    android:text="Price" />

                                <TextView
                                    style="@style/tblCellTextViewHeader"
                                    android:layout_width="80dp"
                                    android:layout_column="4"
                                    android:text="Total" />
                            </TableRow>
                        </TableLayout>
                    </LinearLayout>
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/actual_table_box"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                        </LinearLayout>

                        <LinearLayout
                            style="@style/btnTransparentStyleSmallWrap"
                            android:layout_gravity="right"
                            android:layout_marginTop="7dp"
                            android:layout_marginRight="7dp">

                            <com.balysv.materialripple.MaterialRippleLayout
                                android:id="@+id/btn_add_item"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:padding="3dp">
                                <Button
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/baseline_library_add_24"
                                    android:backgroundTint="@color/white" />
                            </com.balysv.materialripple.MaterialRippleLayout>
                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/poincluded_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentTop="true"
                    android:orientation="vertical"
                    android:paddingLeft="5dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_date"
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:text="Delivery Date :"
                            android:textColor="@color/gray_6"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/et_date"
                            android:layout_width="match_parent"
                            android:layout_height="27dp"
                            android:layout_alignParentRight="true"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/background_round_border_inner"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:gravity="top"
                            android:hint="Click here to add delivery date..."
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:lineHeight="14dp"
                            android:maxLines="2"
                            android:paddingLeft="7dp"
                            android:paddingTop="3dp"
                            android:paddingRight="5dp"
                            android:text=""
                            android:textColor="@color/brown_5"
                            android:textColorHint="@color/gray_4"
                            android:textSize="15dp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginTop="36dp"
                        android:layout_marginRight="5dp"
                        android:background="@color/gray_5" />

                    <LinearLayout
                        android:layout_marginTop="38dp"
                        android:id="@+id/name_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_name_label"
                            android:layout_width="95dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:layout_marginTop="2dp"
                            android:text="Customer :"
                            android:textColor="@color/gray_6"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tv_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="5dp"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/brown_5"
                            android:textSize="18sp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="70dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_remarks"
                            android:layout_width="77dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="3dp"
                            android:text="Remarks :"
                            android:textColor="@color/gray_6"
                            android:textSize="16sp" />

                        <EditText
                            android:id="@+id/et_remarks"
                            android:layout_width="match_parent"
                            android:layout_height="47dp"
                            android:layout_alignParentRight="true"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/background_round_border_inner"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:gravity="top"
                            android:hint="Input remarks here...."
                            android:imeOptions="actionNext"
                            android:inputType="text"
                            android:lineHeight="14dp"
                            android:maxLines="2"
                            android:paddingLeft="7dp"
                            android:paddingTop="3dp"
                            android:paddingRight="5dp"
                            android:text=""
                            android:textColor="@color/brown_5"
                            android:textColorHint="@color/gray_4"
                            android:textSize="15dp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1px"
                        android:layout_marginTop="125dp"
                        android:layout_marginRight="5dp"
                        android:background="@color/gray_5" />

                    <TextView
                        android:id="@+id/tv_items"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="0dp"
                        android:layout_marginTop="144dp"
                        android:text="Item Lists:"
                        android:textColor="@color/brown_5"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_gravity="bottom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingLeft="1dp"
                        android:paddingRight="1dp">

                        <TableRow
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:focusable="true"
                            android:padding="5dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_weight="1"
                                android:gravity="right"
                                android:orientation="horizontal">
                                <LinearLayout
                                    style="@style/btnTransparentStyle"
                                    android:layout_width="140dp">
                                    <com.balysv.materialripple.MaterialRippleLayout
                                        android:id="@+id/btn_submit"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent">
                                        <Button
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="@android:color/transparent"
                                            android:text="SUBMIT"
                                            android:textAllCaps="false"
                                            android:textColor="@color/white" />
                                    </com.balysv.materialripple.MaterialRippleLayout>
                                </LinearLayout>
                            </RelativeLayout>
                        </TableRow>
                    </TableLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:visibility="gone"
                android:backgroundTint="@color/transparent"
                android:layout_alignParentBottom="true"
                android:id="@+id/bs_calculator"
                android:layout_width="match_parent"
                android:layout_marginRight="5dp"
                android:layout_height="215dp"
                android:background="@android:color/darker_gray"
                android:orientation="vertical"
                app:layout_behavior="android.support.design.widget.BottomSheetBehavior">
                <LinearLayout
                    android:layout_gravity="right"
                    android:layout_width="wrap_content"
                    android:layout_height="209dp"
                    android:orientation="horizontal">
                    <GridLayout
                        android:background="@drawable/popupbg"
                        android:alpha="0.8"
                        android:id="@+id/calc_box"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:columnCount="4"
                        android:padding="5dp">
                        <Button
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_7"
                            android:text="7"/>
                        <Button
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_8"
                            android:text="8"/>
                        <Button
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_9"
                            android:text="9"/>
                        <Button
                            android:layout_marginTop="-5dp"
                            style="@style/caclulatorButtonPassive"
                            android:id="@+id/cal_cancel"
                            android:text="CLOSE"/>
                        <Button
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_4"
                            android:text="4"/>
                        <Button
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_5"
                            android:text="5"/>
                        <Button
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_6"
                            android:text="6"/>
                        <Button
                            android:visibility="invisible"
                            style="@style/caclulatorButton"/>
                        <Button
                            android:onClick="calcTriggerBtn"
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_1"
                            android:text="1"/>
                        <Button
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_2"
                            android:text="2"/>
                        <Button
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_3"
                            android:text="3"/>
                        <Button
                            android:visibility="invisible"
                            style="@style/caclulatorButton"/>
                        <Button
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_0"
                            android:text="0"/>
                        <Button
                            style="@style/caclulatorButton"
                            android:id="@+id/cal_dot"
                            android:text="."/>
                        <Button
                            android:layout_marginTop="-4dp"
                            style="@style/caclulatorButton"
                            android:backgroundTint="@color/brown_5"
                            android:textColor="@color/white"
                            android:textSize="17dp"
                            android:id="@+id/cal_delete"
                            android:text="DEL"/>
                    </GridLayout>
                </LinearLayout>
            </LinearLayout>

        </android.support.design.widget.CoordinatorLayout>

    </LinearLayout>

</RelativeLayout>
