<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
    <item android:state_pressed="true" >
        <shape android:shape="rectangle"  >
            <corners android:topLeftRadius="3dp" android:bottomLeftRadius="3dp"
                android:topRightRadius="3dp" android:bottomRightRadius="3dp"/>
            <solid android:color="@color/blue_3a" />
            <stroke android:color="@color/blue_4" android:width="1dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle"  >
            <corners android:topLeftRadius="3dp" android:bottomLeftRadius="3dp"
                android:topRightRadius="3dp" android:bottomRightRadius="3dp"/>
            <gradient
                android:angle="180"
                android:startColor="@color/blue_2a"
                android:centerColor="@color/blue_1a"
                android:endColor="@color/blue_1a"
                android:type="linear" />
            <!--solid android:color="#44284E38" /-->
            <stroke android:color="@color/blue_2" android:width="1dp" />
        </shape>
    </item>
</selector>