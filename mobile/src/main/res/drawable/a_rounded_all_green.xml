<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" >
    <item android:state_pressed="true" >
        <shape android:shape="rectangle"  >
            <corners android:topLeftRadius="3dp" android:bottomLeftRadius="3dp"
                android:topRightRadius="3dp" android:bottomRightRadius="3dp"/>
            <solid android:color="#77284E38" />
            <stroke android:color="@color/green_4" android:width="1dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle"  >
            <corners android:topLeftRadius="3dp" android:bottomLeftRadius="3dp"
                android:topRightRadius="3dp" android:bottomRightRadius="3dp"/>
            <solid android:color="#44284E38" />
            <stroke android:color="@color/green_3" android:width="1dp" />
        </shape>
    </item>
</selector>